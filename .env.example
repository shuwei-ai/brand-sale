# ── 运行环境 ─────────────────────────────────────────────
BM_ENV=dev
BM_HTTP_PORT=8787
BM_DATA_DIR=./.data

# ── 前端控制台（React 版）────────────────────────────────
# 网关托管的构建产物目录。留空 = 用默认值 apps/web/dist（相对仓库根，
# 与启动时的工作目录无关）；前端由 CDN 发布时在这里指向本地回退目录。
# 目录里没有 index.html 时，`/` 会返回内置引导页（纯静态、零外部资源，只说明如何构建，不做任何 API 调用）。
# BM_WEB_DIST=./apps/web/dist

# ── 存储 ─────────────────────────────────────────────────
# sqlite | postgres  (Phase 1 仅实现 sqlite)
BM_STORAGE_DRIVER=sqlite
# BM_POSTGRES_URL=postgres://user:pass@localhost:5432/brandsale

# ── 模型网关 M14 ─────────────────────────────────────────
# live = 调用真实 OpenAI 兼容端点；mock = 离线确定性桩（无需网络）
BM_LLM_MODE=live
BM_LLM_BASE_URL=http://124.174.44.116:8000/v1
BM_LLM_API_KEY=sk-local-dev
BM_MODEL_STRONG=qwen3.8-flash-next
BM_MODEL_MEDIUM=qwen3.8-flash-next
BM_MODEL_LIGHT=qwen3.8-flash-next
BM_LLM_CONCURRENCY=4
# 单次模型请求超时（毫秒）。流式语义 = "相邻两个 chunk 的最大间隔"（即空闲超时）。
# 自建端点有冷启动：模型未驻留时请求可能先"连上但不吐 token"数分钟，冷启动完成后同一次
# 请求会正常返回。设太短会在冷启动期间误判失败，默认给 5 分钟（任何阶段预算不低于它 +60s）。
BM_LLM_TIMEOUT_MS=300000
BM_LLM_MAX_RETRIES=2
# 百万级上下文模型，单次输出上限
BM_LLM_MAX_OUTPUT_TOKENS=4096
# vLLM 上关闭思维链可显著降延迟（qwen3 系支持 chat_template_kwargs）
BM_LLM_DISABLE_THINKING=true

# ── 成本（元 / 千 token，仅用于估算与门禁）────────────────
BM_PRICE_INPUT_PER_1K=0.001
BM_PRICE_OUTPUT_PER_1K=0.002

# ── 检索 M7 ──────────────────────────────────────────────
# 向量存储驱动：
#   memory  = 向量落在 SQLite（kb_chunks.vec）+ 应用层暴力余弦。**默认、推荐**（万级 chunk 毫秒级，
#             且向量与 chunk 同事务读写，不会出现"chunk 删了向量还在"）。
#   milvus  = 额外把密向量写入 Milvus（可重建的索引，不是真相源）。仅在语料量/多实例等
#             触发条件满足时启用，见 docs/report-summary-vectordb-integration-plan.md §6。
# 注意：SQLite 永远是唯一真相源；Milvus 挂了会降级为 SQLite 语义 + 关键词，不会让检索失败。
BM_VECTOR_DRIVER=memory
# 嵌入服务（services/embedding-core，EmbeddingGemma 2）。
# Docker 部署：npm run embedding:up  →  服务发布在 127.0.0.1:8899
# 留空 = 语义通道退回本地 256 维字符哈希占位实现（本质是词袋，不是语义向量）。
# 填上之后建议跑一次 `npm run embedding:backfill` 给存量语料补算向量。
BM_EMBED_URL=http://127.0.0.1:8899/v1/embeddings
BM_EMBED_MODEL=embeddinggemma-2
# 向量维度：必须与嵌入服务一致。EmbeddingGemma 2 原生 768。
# ⚠️ 它同时决定落盘向量能参与比较的范围；换维度后旧向量会被判定为"其他模型"而跳过，
#    需 `npm run embedding:backfill -- --force` 重算。
BM_EMBED_DIM=768
BM_EMBED_BATCH_SIZE=32
BM_EMBED_TIMEOUT_MS=60000
# Milvus（仅 BM_VECTOR_DRIVER=milvus 时使用）。npm run milvus:up → REST 在 19530
# （**不是 9091，9091 只有健康端点，打 /v2/vectordb/* 会返回 404**）
BM_MILVUS_URI=http://127.0.0.1:19530
BM_MILVUS_COLLECTION=brandsale_kb
# dev 的 Standalone 默认无鉴权，留空即可；生产需开 authorizationEnabled 并填 user:password
BM_MILVUS_TOKEN=
# 3s 而不是 30s：Milvus 是旁路，挂了就该立刻退回 SQLite + BM25，不要拖到工具超时（20s）
BM_MILVUS_TIMEOUT_MS=3000
BM_RERANK_URL=
BM_RERANK_MODEL=
BM_RERANK_POOL_SIZE=50
BM_RERANK_TIMEOUT_MS=30000
BM_RERANK_COOLDOWN_MS=30000

# ── 知识库回灌 M7 ────────────────────────────────────────
# 报告产出后，把**机械抽取**的摘要写进 KB-2（sourceId=report_summary），
# 让"这家客户过去做过什么"进入后续任务的检索范围。失败不影响报告本身（best-effort）。
BM_SUMMARY_INGEST=true

# ── 解析 M6（Phase 1 用内置 textonly 解析器）──────────────
# 留空 = 仅支持纯文本入库（text/plain、text/markdown）。
# 填 MinerU 服务地址（可自部署，Apache-2.0）后，KB 入库通道即可接收 pdf/docx/xlsx/pptx。
# 未配置时上传二进制会返回 415 E-INGEST-002，**不会**退化成"把二进制当文本塞进库"。
# 注意：**没有**"解析器降级"开关。MinerU 不可用时采集/入库会明确失败而不是悄悄降级 ——
# 那正是要防的"乱码 chunk 能检索、能被引用、但毫无意义"（见 packages/knowledge/src/parser.ts）。
BM_PARSER_URL=
# 文档解析超时。远高于普通接口——pdf/扫描件解析本身就慢
BM_PARSER_TIMEOUT_MS=60000

# ── 渲染 M11 ─────────────────────────────────────────────
BM_RENDER_ENGINE=markdown

# ── 报告深度预算（P2-2）──────────────────────────────────
# 一份 12+ 页、含真表格与图表的报告 DSL 约 40–60KB JSON（≈2 万+ token）。
# 若沿用网关默认的 4096 输出上限，必然截断 → 截断即走合成兜底 →
# 报告顶部出现误导性的「模型不可用」。所以 report 阶段单列预算。
# 说明：BM_LLM_MAX_OUTPUT_TOKENS 仍是全局默认，report 阶段优先读下面这组。
BM_REPORT_MAX_TOKENS=32768
# 提示词里注入的上游产物字符上限（越大越完整，但更耗 token）
BM_REPORT_CONTEXT_CHARS=48000
# 报告页数下限：低于此值触发一次「补深度」重跑；仍不足则如实标 degraded
BM_REPORT_MIN_SLIDES=12

# ── 联网检索（火山引擎「联网搜索 Lite」）──────────────────
# 抓公开网页，按 L3 处理（公开但未经人工核验，报告引用必须带来源站点）。
# 打开后：intel 阶段会预取一次检索，CI Agent 也可在工具循环里主动调用。
# 清空 KEY 即整体关闭——适配器不注册，web_search 也不会出现在 Agent 的工具清单里。
# 申请入口：https://www.volcengine.com/docs/87772/2272953?lang=zh
BM_WEB_SEARCH_ENABLED=true
BM_WEB_SEARCH_URL=https://open.feedcoopapi.com/search_api/web_search
BM_WEB_SEARCH_API_KEY=
BM_WEB_SEARCH_COUNT=20
BM_WEB_SEARCH_MAX_COUNT=50
BM_WEB_SEARCH_TIMEOUT_MS=8000
# 相同查询的结果缓存（秒）；网页时效性强，默认 15 分钟
BM_WEB_SEARCH_CACHE_TTL=900
# intel 阶段是否自动预取一次检索（关闭后仅允许 Agent 在工具循环里主动调用）
BM_WEB_SEARCH_PREFETCH=true

# ── 平台内公开内容采集（七个平台，L3）────────────────────
# 覆盖：小红书 / 抖音 / 快手 / B站 / 微博 / 贴吧 / 知乎。
# 实现：MediaCrawler（NanmiCoder/MediaCrawler）的采集内核**已内嵌进本仓库**
#      （services/collector-core），部署上只有 brandsale 一个系统。
#      中间仍隔一个只读归一化 sidecar（apps/collector）把"采"与"查"解耦：
#      内核是「起浏览器 → 扫码 → 分钟级落盘」，而工具层要的是「同步、按查询、带 provenance」。
#      collector 用子进程直接驱动内核，不再需要独立的 MediaCrawler 服务与端口。
#
# ⚠️⚠️ 许可证红线（请先读完再决定是否打开）⚠️⚠️
#   MediaCrawler 的许可证是 NON-COMMERCIAL LEARNING LICENSE 1.1，条件第 3 条：
#   「未经版权所有者书面同意，不得将本软件用于任何商业用途」。
#   brandsale 是商业交付系统（报告直接指导甲方真实投放预算），因此：
#     · 只有在**取得版权方书面同意**，或你已在合规上**明确接受该风险**时，
#       才把 BM_MC_LICENSE_ACK 设为 true；
#     · 为 false 时，七个适配器与七个平台工具**一律不注册**，
#       报告会如实写"无平台数据"——这是刻意设计成"必须显式做一次决定"。
#
# 分级一律 L3：公开、未经人工核验，且与平台**不存在授权合同**（因此禁止填 contractRef）。
# 只能支撑"关于他人"的公开断言，不得当作甲方自身的实测经营数据。
#
# ── 三道门，缺一不可 ──
#   1) BM_MC_ENABLED=true           总开关
#   2) BM_MC_LICENSE_ACK=true       许可确认（见上）
#   3) BM_MC_COLLECTOR_URL 已配 + collector 已在跑
#      （首次先 npm run collector:setup 准备内核 Python 环境，再 npm run collector。
#        setup 里 chromium 下载失败**不影响使用**：默认 --cdp auto 直接驱动本机 Chrome/Edge。）
BM_MC_ENABLED=false
BM_MC_LICENSE_ACK=false
# collector sidecar 地址（brandsale 侧用它查询）
BM_MC_COLLECTOR_URL=http://127.0.0.1:8890
# 平台开关：逗号分隔，默认七平台全开。只登录了部分平台时收窄，例如 BM_MC_PLATFORMS=dy,xhs
BM_MC_PLATFORMS=xhs,dy,ks,bili,wb,tieba,zhihu
# 预采集覆盖范围（只影响 intel 阶段的自动预取，不影响工具装配与模型按需调用）：
#   brief（默认）—— 只采 brief 声明的平台。平台采集是分钟级的，为"客户没打算投"的平台
#     各跑一轮纯属白烧；报告来源声明里本来就会把它们写成「不在本次调研范围」。
#   all —— 全部已装配平台。需要"这个话题此刻在哪些平台被讨论"的跨平台视野时才开。
# 注意 brief 声明了平台但一个都没装配时会**不投递**（不改成采别的平台）；
# brief 完全没声明平台时退回 all 的行为，避免整份报告拿不到平台证据。
BM_MC_PREFETCH_SCOPE=brief
BM_MC_TIMEOUT_MS=15000
BM_MC_CACHE_TTL=1800

# ── collector sidecar（独立进程，npm run collector）────────
# 以下变量由 collector 读取；它不与主程序抢同一组名字，避免同名不同义。
# 采集内核目录（在仓库内）。留空 = services/collector-core
BM_MC_CORE_DIR=services/collector-core
# 内核 Python 解释器。留空 = 优先 <coreDir>/.venv/bin/python，其次 PATH 上的 python3
BM_MC_PYTHON=
# 采集落盘目录（作为内核 --save-path）。留空 = <coreDir>/data
BM_MC_DATA_DIR=
# 子进程日志目录（每次采集一个 <taskId>.log）
BM_MC_LOG_DIR=./.data-collector/logs
# 归一化结果的本地缓存目录
BM_COLLECTOR_DATA=./.data-collector
BM_COLLECTOR_HOST=127.0.0.1
BM_COLLECTOR_PORT=8890
# 采集时是否无头。本机**扫码登录需要可见窗口**，所以默认 false
BM_MC_HEADLESS=false
# 浏览器启动模式，透传给内核 --cdp：
#   reuse = **常驻复用（默认）**。端口上有该平台的常驻浏览器就直接接上、没有才拉起，
#           且退出时**不关闭**它，留给同平台的下一个任务。窗口数从"任务数"降到"平台数"，
#           该平台无待跑采集时由 collector 回收（内核侧每次 20 个任务 = 20 次窗口闪烁的
#           观感问题就是这么来的）。端口按平台固定取自 MEDIA_CRAWLER_PLATFORM_META[].cdpPort。
#   auto  = 每次采集都新开一个浏览器（本机有 Chrome/Edge 就直接驱动它，隔离 profile）
#   true  = 强制 CDP（本机没有 Chrome/Edge 时会失败）
#   false = 强制 playwright 自带 chromium（需先 playwright install chromium，约 150MB）
BM_MC_CDP=reuse
# 单次采集条数上限（默认 50，硬上限 200）
BM_MC_MAX_ITEMS=50
BM_MC_MAX_ITEMS_CAP=200
# 搜索完成后自动补采作者**个人主页资料**（粉丝数/关注数/主页链接）—— 内容行里不带粉丝数，
# 报告人选页的"粉丝量"一列全靠这条链路。默认开；profile-only，一次主页接口，单次几秒。
BM_MC_PROFILE_ENRICH=true
# 一次搜索最多补几位作者（默认 30）。作者数比它多时，超出的作者粉丝量会留在「未采集」，
# 报告不会用 0 或估算值顶替 —— 那正是"跑完一看还是未采集"的成因。整批作者合成一个任务跑。
BM_MC_PROFILE_ENRICH_MAX=30
# 账号昵称是否打码（`张***三`）。默认 false = **完整显示**（业主要求报告里的人选/账号不要 ****）。
# 置 true 才恢复上游教学版的中间脱敏。该值会显式透传给采集内核子进程。
BM_MC_MASK_NICKNAME=false
# 单次采集的等待上限（毫秒）。采集是分钟级、首次含扫码，默认 10 分钟
BM_MC_CRAWL_TIMEOUT_MS=600000
# 内核自检超时（毫秒）：要 import 七个平台的全部依赖，比一般请求宽
BM_MC_ENV_CHECK_TIMEOUT_MS=60000

# ── 数据源分级总开关 ─────────────────────────────────────
BM_L1_ENABLED=true
BM_L2_ENABLED=true
BM_L3_ENABLED=true
# L4 第三方数据：默认关闭（除配置外还需法务审批 legal_approved）
BM_L4_ENABLED=false

# ── 工具写能力总开关（安全）──────────────────────────────
# 是否允许注册 mutating 工具（发帖/点赞/评论/关注/删除等改变外部系统状态的操作）。
# 默认 false。公开采集类工具包常同时提供读与写，整包封装后模型可能以甲方名义产生副作用。
# 打开前请确认：该工具已挂 authz 检查、且确实只封装了需要的写命令。
BM_TOOLS_ALLOW_MUTATING=false

# ── 知识库入库通道 M7（P1-5）────────────────────────────
# 是否允许写入跨租户共享的全局语料（KB-3 公开情报 / KB-4 方法论，tenant_id=''）。
# 默认 false。当前 TenantContext 尚无角色概念，"仅 admin 可写全局"暂时落在部署配置上。
BM_KB_ALLOW_GLOBAL_WRITE=false

# ── 任务运行时 M12 ───────────────────────────────────────
BM_MAX_JOB_MINUTES=60
BM_ALLOW_PARTIAL=true

# ── 数据真实性（业主明确要求）─────────────────────────────
# 是否允许把**内置演示样例**当可用数据：seed 灌入的 5 位样例达人及其报价、
# 以及演示用的 KB-2/KB-3/KB-4 语料（库内标记 provenance='demo'）。
#
# 默认 false：报告里的每个账号、每句结论都必须能追溯到真实来源
# （客户录入 / 平台采集 / 联网检索）。样例达人只有昵称、没有平台账号 ID，
# 报告一旦引用，客户去平台搜索必然搜不到 —— 那次"报告数据是不是编的"的疑问就是这么来的。
# 打开它（true）只为跑演示与部分自动化测试。
BM_ALLOW_DEMO_DATA=false

# ── 观测 M13 ─────────────────────────────────────────────
BM_TRACE_CONTENT=false
BM_OTEL_ENDPOINT=
BM_LANGFUSE_URL=
BM_LOG_LEVEL=info

# ── 闸门 M3（必须为 true，仅测试可改）─────────────────────
BM_GATE_FAIL_CLOSED=true
