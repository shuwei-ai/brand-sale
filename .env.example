# ── 运行环境 ─────────────────────────────────────────────
BM_ENV=dev
BM_HTTP_PORT=8787
BM_DATA_DIR=./.data

# ── 存储 ─────────────────────────────────────────────────
# sqlite | postgres  (Phase 1 仅实现 sqlite)
BM_STORAGE_DRIVER=sqlite
# BM_POSTGRES_URL=postgres://user:pass@localhost:5432/brandsale

# ── 模型网关 M14 ─────────────────────────────────────────
# live = 调用真实 OpenAI 兼容端点；mock = 离线确定性桩（无需网络）
BM_LLM_MODE=live
BM_LLM_BASE_URL=http://124.174.44.116:8000/v1
BM_LLM_API_KEY=sk-local-dev
BM_MODEL_STRONG=qwen3.8-flash-next
BM_MODEL_MEDIUM=qwen3.8-flash-next
BM_MODEL_LIGHT=qwen3.8-flash-next
BM_LLM_CONCURRENCY=4
BM_LLM_TIMEOUT_MS=180000
BM_LLM_MAX_RETRIES=2
# 百万级上下文模型，单次输出上限
BM_LLM_MAX_OUTPUT_TOKENS=4096
# vLLM 上关闭思维链可显著降延迟（qwen3 系支持 chat_template_kwargs）
BM_LLM_DISABLE_THINKING=true

# ── 成本（元 / 千 token，仅用于估算与门禁）────────────────
BM_PRICE_INPUT_PER_1K=0.001
BM_PRICE_OUTPUT_PER_1K=0.002

# ── 检索 M7 ──────────────────────────────────────────────
BM_VECTOR_DRIVER=memory
BM_EMBED_URL=
BM_EMBED_MODEL=
BM_RERANK_URL=
BM_RERANK_MODEL=
BM_RERANK_POOL_SIZE=50
BM_RERANK_TIMEOUT_MS=30000
BM_RERANK_COOLDOWN_MS=30000

# ── 解析 M6（Phase 1 用内置 textonly 解析器）──────────────
# 留空 = 仅支持纯文本入库（text/plain、text/markdown）。
# 填 MinerU 服务地址（可自部署，Apache-2.0）后，KB 入库通道即可接收 pdf/docx/xlsx/pptx。
# 未配置时上传二进制会返回 415 E-INGEST-002，**不会**退化成"把二进制当文本塞进库"。
BM_PARSER_URL=
BM_PARSER_FALLBACK=textonly
# 文档解析超时。远高于普通接口——pdf/扫描件解析本身就慢
BM_PARSER_TIMEOUT_MS=60000

# ── 渲染 M11 ─────────────────────────────────────────────
BM_RENDER_ENGINE=markdown

# ── 报告深度预算（P2-2）──────────────────────────────────
# 一份 12+ 页、含真表格与图表的报告 DSL 约 40–60KB JSON（≈2 万+ token）。
# 若沿用网关默认的 4096 输出上限，必然截断 → 截断即走合成兜底 →
# 报告顶部出现误导性的「模型不可用」。所以 report 阶段单列预算。
# 说明：BM_LLM_MAX_OUTPUT_TOKENS 仍是全局默认，report 阶段优先读下面这组。
BM_REPORT_MAX_TOKENS=32768
# 提示词里注入的上游产物字符上限（越大越完整，但更耗 token）
BM_REPORT_CONTEXT_CHARS=48000
# 报告页数下限：低于此值触发一次「补深度」重跑；仍不足则如实标 degraded
BM_REPORT_MIN_SLIDES=12

# ── 联网检索（火山引擎「联网搜索 Lite」）──────────────────
# 本项目**唯一**会真正发起外部请求的数据源：抓公开网页，按 L3 处理
# （公开但未经人工核验，报告引用必须带来源站点）。
# 打开后：intel 阶段会预取一次检索，CI Agent 也可在工具循环里主动调用。
# 清空 KEY 即整体关闭——适配器不注册，web_search 也不会出现在 Agent 的工具清单里。
# 申请入口：https://www.volcengine.com/docs/87772/2272953?lang=zh
BM_WEB_SEARCH_ENABLED=true
BM_WEB_SEARCH_URL=https://open.feedcoopapi.com/search_api/web_search
BM_WEB_SEARCH_API_KEY=
BM_WEB_SEARCH_COUNT=20
BM_WEB_SEARCH_MAX_COUNT=50
BM_WEB_SEARCH_TIMEOUT_MS=8000
# 相同查询的结果缓存（秒）；网页时效性强，默认 15 分钟
BM_WEB_SEARCH_CACHE_TTL=900
# intel 阶段是否自动预取一次检索（关闭后仅允许 Agent 在工具循环里主动调用）
BM_WEB_SEARCH_PREFETCH=true

# ── 抖音公开内容（自托管采集，L3）────────────────────────
# 对接 Evil0ctal/Douyin_TikTok_Download_API（Apache-2.0）自建服务，**只读子集**：
# 达人主页 / 作品列表 / 作品详情 / 评论。不做搜索、不做热榜、不做关注粉丝列表、无任何写操作。
#
# 分级是 L3（公开、未经人工核验），**不是 L1**：这条链路与抖音之间没有授权合同，
# 标成 L1 等于把公开采集洗成甲方授权实测。L3 源还禁止填 contractRef（登记期直接报错）。
#
# 未配置 BASE_URL 时适配器不注册，douyin_creator / douyin_comments 也不会出现在工具清单里。
# 本地联调：npm run datasource:lab 起假数据源，把地址填成本地端口即可。
BM_DOUYIN_ENABLED=true
# 形态：v4 | v5，**默认 v5**。当前仓库 docker compose 装出来的 DTK 是 5.1.x（v5）。
# 两代的端点前缀、wait 语义、鉴权、信封全都不一样，写错形态四个端点会全部 404；
# 认不出的值会直接抛错而不是静默退回默认。对接老版本时显式设成 v4。
BM_DOUYIN_STYLE=v5
BM_DOUYIN_BASE_URL=
# v5 默认强制鉴权（X-API-Key / Bearer）；v4 留空即可。
# v5 还需在 DTK 控制台加至少一个身份，否则请求只会拿到 202 + task_id。
BM_DOUYIN_API_KEY=
# wait：v4 是布尔 true；v5 是**秒数**（上限 api.max_wait_seconds，DTK 默认 30）。
# 留空 = 按 BM_DOUYIN_STYLE 取默认（v4→true，v5→20）。
BM_DOUYIN_WAIT=
BM_DOUYIN_TIMEOUT_MS=15000
BM_DOUYIN_CACHE_TTL=1800
# 端点路径：留空 = 按 BM_DOUYIN_STYLE 取默认。只在"v5 但改了路径"这类情况下才需要填。
BM_DOUYIN_PATH_PROFILE=
BM_DOUYIN_PATH_POSTS=
BM_DOUYIN_PATH_VIDEO=
BM_DOUYIN_PATH_COMMENTS=

# ── 小红书公开内容（自托管只读代理，L3）───────────────────
# 必须经**只读代理**而不是直连采集工具：可用的开源工具是 CLI、需登录 Cookie、
# 且同时提供写命令（发笔记/点赞/评论/关注/删除）。整包封装后模型可能以甲方账号名义产生副作用。
# 所以这里只认一个"只暴露只读子命令"的 HTTP 代理，契约见 docs/datasource-integration.md。
#
# 风控是常态：单账号、Cookie 约 7 天、可能触发验证码或被封 IP。
# 这几类失败会被翻译成可执行的处置说明（去登录 / 完成验证 / 换出口 IP），而不是笼统报"不可用"。
BM_XHS_ENABLED=true
BM_XHS_BASE_URL=
BM_XHS_API_KEY=
# 代理内部是 spawn CLI + 内置人类化延迟（~1-1.5s/次），所以超时给得比抖音宽
BM_XHS_TIMEOUT_MS=25000
BM_XHS_CACHE_TTL=1800
BM_XHS_PATH_NOTE=/xhs/note
BM_XHS_PATH_COMMENTS=/xhs/comments
BM_XHS_PATH_USER=/xhs/user
BM_XHS_PATH_USER_POSTS=/xhs/user-posts

# ── 数据源分级总开关 ─────────────────────────────────────
BM_L1_ENABLED=true
BM_L2_ENABLED=true
BM_L3_ENABLED=true
# L4 第三方数据：默认关闭（除配置外还需法务审批 legal_approved）
BM_L4_ENABLED=false

# ── 工具写能力总开关（安全）──────────────────────────────
# 是否允许注册 mutating 工具（发帖/点赞/评论/关注/删除等改变外部系统状态的操作）。
# 默认 false。公开采集类工具包常同时提供读与写，整包封装后模型可能以甲方名义产生副作用。
# 打开前请确认：该工具已挂 authz 检查、且确实只封装了需要的写命令。
BM_TOOLS_ALLOW_MUTATING=false

# ── 知识库入库通道 M7（P1-5）────────────────────────────
# 是否允许写入跨租户共享的全局语料（KB-3 公开情报 / KB-4 方法论，tenant_id=''）。
# 默认 false。当前 TenantContext 尚无角色概念，"仅 admin 可写全局"暂时落在部署配置上。
BM_KB_ALLOW_GLOBAL_WRITE=false

# ── 任务运行时 M12 ───────────────────────────────────────
BM_MAX_JOB_MINUTES=60
BM_ALLOW_PARTIAL=true

# ── 观测 M13 ─────────────────────────────────────────────
BM_TRACE_CONTENT=false
BM_OTEL_ENDPOINT=
BM_LANGFUSE_URL=
BM_LOG_LEVEL=info

# ── 闸门 M3（必须为 true，仅测试可改）─────────────────────
BM_GATE_FAIL_CLOSED=true
