{
  "name": "brandsale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "品牌营销 AI 策略咨询系统 · 可运行纵切（Phase 1）",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @brandsale/web",
    "web:dev": "npm run dev --workspace @brandsale/web",
    "web:build": "npm run build --workspace @brandsale/web",
    "web:preview": "npm run preview --workspace @brandsale/web",
    "migrate": "tsx packages/storage/src/cli.ts migrate",
    "seed": "tsx scripts/seed.ts",
    "dev": "tsx watch apps/gateway/src/main.ts",
    "start": "tsx apps/gateway/src/main.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:mock": "BM_LLM_MODE=mock tsx scripts/demo.ts",
    "collector": "tsx apps/collector/src/main.ts",
    "collector:setup": "bash services/collector-core/setup.sh",
    "datasource:smoke": "tsx scripts/datasource-smoke.ts",
    "test": "BM_LLM_MODE=mock BM_ALLOW_DEMO_DATA=true BM_MC_ENABLED=false BM_MC_LICENSE_ACK=false BM_MC_COLLECTOR_URL= BM_VECTOR_DRIVER=memory BM_EMBED_URL= BM_EMBED_MODEL= node --import tsx --test tests/*.test.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "semantic:smoke": "tsx scripts/semantic-memory-smoke.ts",
    "embedding:setup": "bash services/embedding-core/setup.sh",
    "embedding:up": "docker compose -f services/embedding-core/docker-compose.yml up -d --build",
    "embedding:down": "docker compose -f services/embedding-core/docker-compose.yml down",
    "embedding:logs": "docker compose -f services/embedding-core/docker-compose.yml logs -f",
    "milvus:up": "docker compose -f infra/milvus/docker-compose.yml up -d",
    "milvus:down": "docker compose -f infra/milvus/docker-compose.yml down",
    "stack:up": "npm run milvus:up && npm run embedding:up",
    "stack:down": "npm run embedding:down && npm run milvus:down",
    "embedding:backfill": "tsx scripts/embedding-backfill.ts",
    "vector:rebuild": "tsx scripts/vector-rebuild.ts",
    "vector:demo": "tsx scripts/vector-semantic-demo.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-durable": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
