node_modules/
dist/
*.log
*.tsbuildinfo

# Python 运行时缓存
__pycache__/
*.pyc

# 环境变量（含 BM_LLM_API_KEY / BM_WEB_SEARCH_API_KEY），只提交 .env.example
# .env.* 覆盖 .env.bak.* / .env.local 等一切变体——本次差点把含真密钥的
# .env.bak.20261012-* 推上公开仓库（2026-10-14）。!.env.example 负责放行模板。
.env
.env.*
!.env.example

# 运行时数据库目录（sqlite + WAL/SHM）。注意 .data-*/ 覆盖 .data-live / .data-console / .data-test
.data/
.data-*/
.data-backup-*/

# Milvus 数据卷（向量索引 + etcd + minio）。可重建，且含客户语料的语义指纹，不入库
infra/milvus/volumes/

# 嵌入服务的 Python 环境与模型权重（约 1.4GB，由 npm run embedding:setup 重建）
services/embedding-core/.venv/
services/embedding-core/models/

# Spider_XHS 本地克隆（无上游 LICENSE；按业主个人使用决定保留在本机，不进公开仓库）
services/spider-xhs/

# DouYin_Spider 本地克隆（无上游 LICENSE；同上）
services/douyin-spider/

# 生成的报告产物（HTML / Markdown / DSL JSON）
out/
output/

# 助手注册命令缓存（本地生成，不进库）
.wechat-agent/

# 项目内助手工作记忆（本地保留，不公开）
.workbuddy/

# 发布应用（sites）的本地标记文件
*.genie

.DS_Store
